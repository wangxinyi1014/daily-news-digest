# ============================================
# 每日全球要闻推送 — 环境变量配置
# 复制此文件为 .env 并填入你自己的密钥
# ============================================

# DeepSeek API Key（去 platform.deepseek.com 注册拿 key）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Server酱 SendKey（去 sct.ftqq.com 注册拿 key）
# 支持多人推送：多个 Key 用英文逗号隔开，例如：
#   SERVERCHAN_SENDKEY=SCT123456yourkey,SCT789012friendkey
SERVERCHAN_SENDKEY=SCT123456yourkeyhere

# Telegram Bot（搜 @BotFather 创建 → @userinfobot 查 Chat ID）
# GitHub Actions 海外 runner 连国内 Server酱 容易被墙，
# Telegram 作为备选/主推送通道，全球可达。
TELEGRAM_BOT_TOKEN=123456:ABCdef...
TELEGRAM_CHAT_ID=你的数字ID

# 搜索 API 密钥（均可选）
# Exa 为首选搜索引擎；没配 EXA_API_KEY 则自动退而使用 Tavily；
# 两个都没配时侦察兵会静默跳过搜索工具调用（不影响其他功能）。
EXA_API_KEY=
TAVILY_API_KEY=

# 输出语言：zh（中文，默认）/ en（英文）/ bilingual（中英双语）
DIGEST_LANG=zh
